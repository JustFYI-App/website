---
/**
 * Screenshot Placeholder Icon (Mobile frame)
 * Used in: Screenshot section
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
  <rect x="3" y="2" width="18" height="20" rx="2"></rect>
  <line x1="12" y1="18" x2="12" y2="18.01"></line>
</svg>
